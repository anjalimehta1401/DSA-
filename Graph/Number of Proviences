
import java.util.*;

class Solution {

    // DFS function
    static void dfs(int node,
                    ArrayList<ArrayList<Integer>> adj,
                    int[] vis) {

        // Mark current city as visited
        vis[node] = 1;

        // Check all cities connected to current city
        for (int neighbour = 0; neighbour < adj.size(); neighbour++) {

            if (adj.get(node).get(neighbour) == 1
                    && vis[neighbour] == 0) {

                dfs(neighbour, adj, vis);
            }
        }
    }

    static int numProvinces(ArrayList<ArrayList<Integer>> adj, int V) {

        int[] vis = new int[V];

        int count = 0;

        // Check every city
        for (int i = 0; i < V; i++) {

            if (vis[i] == 0) {

                count++;

                dfs(i, adj, vis);
            }
        }

        return count;
    }

    public static void main(String[] args) {

        int V = 3;

        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();

        int[][] matrix = {
            {1, 1, 0},
            {1, 1, 0},
            {0, 0, 1}
        };

        for (int i = 0; i < V; i++) {

            ArrayList<Integer> row = new ArrayList<>();

            for (int j = 0; j < V; j++) {
                row.add(matrix[i][j]);
            }

            adj.add(row);
        }

        System.out.println(numProvinces(adj, V));
    }
}
